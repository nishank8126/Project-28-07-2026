#version 450

layout(local_size_x = 256) in;

struct PointVertex {
    vec4 position;
    vec4 color;
    float intensity;
    float classification;
    vec3 normal;
};

layout(push_constant) uniform CullPushConstants {
    mat4 viewProjection;
    vec4 frustumPlanes[6];
    uint totalPoints;
    uint outputOffset;
    float pointSize;
    uint maxOutputPoints;
    float viewportHeight;
    float viewportWidth;
    float tanHalfFov;
    uint padding0;
    uint padding1;
};

layout(binding = 0, set = 0) buffer readonly InputPoints {
    PointVertex inputPoints[];
};

layout(binding = 1, set = 0) buffer OutputPoints {
    PointVertex outputPoints[];
};

layout(binding = 2, set = 0) buffer DrawIndirectArgs {
    uint drawCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

shared uint densityGrid[4096];

uint GridHash(uint x, uint y) {
    return ((x * 73856093u) ^ (y * 19349663u)) & 4095u;
}

bool TestPointInFrustum(vec4 pos) {
    for (int i = 0; i < 6; i++) {
        if (dot(frustumPlanes[i], pos) < 0.0) {
            return false;
        }
    }
    return true;
}

void main() {
    if (gl_LocalInvocationIndex == 0) {
        for (uint i = 0; i < 4096; i++) {
            densityGrid[i] = 0;
        }
    }
    barrier();

    uint idx = gl_GlobalInvocationID.x;
    if (idx >= totalPoints) return;

    vec4 pos = inputPoints[idx].position;

    if (!TestPointInFrustum(pos)) return;

    vec4 clipPos = viewProjection * inputPoints[idx].position;
    float w = clipPos.w;
    if (w <= 0.0) return;

    float ndcX = clipPos.x / w;
    float ndcY = clipPos.y / w;
    float screenX = (ndcX * 0.5 + 0.5) * viewportWidth;
    float screenY = (ndcY * 0.5 + 0.5) * viewportHeight;

    uint pixelX = uint(clamp(screenX, 0.0, viewportWidth - 1.0));
    uint pixelY = uint(clamp(screenY, 0.0, viewportHeight - 1.0));

    uint gridIdx = GridHash(pixelX, pixelY);

    uint pointHash = idx * 1664525u + 1013904223u;
    pointHash ^= pointHash >> 13;
    pointHash *= 1664525u;
    pointHash ^= pointHash >> 13;

    uint existing = atomicMin(densityGrid[gridIdx], pointHash + 1);
    if (existing != 0 && existing != pointHash + 1) {
        return;
    }

    // Early budget check before atomic to avoid inflating drawCount
    if (maxOutputPoints > 0 && drawCount >= maxOutputPoints) {
        return;
    }

    // Use drawCount (SSBO, device memory) as global atomic output index.
    // This is shared across ALL workgroups, so each thread gets a unique index.
    uint globalIdx = atomicAdd(drawCount, 1u);

    if (maxOutputPoints > 0 && globalIdx >= maxOutputPoints) {
        atomicMin(densityGrid[gridIdx], 0);
        return;
    }

    outputPoints[outputOffset + globalIdx] = inputPoints[idx];
}
